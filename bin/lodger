#!/usr/bin/env python3
"""Run lodger straight from a checkout (no install needed): `bin/lodger --help`.
The same command is installed as `lodger` by pip, pipx and uv; both call lodger/cli.py."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))

from lodger.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
