# lodger serve for this PC: http://127.0.0.1:8181/v1 (only this PC can reach it).
# Starts with your desktop session and stops when you log out. The model itself loads on the first
# request and unloads after 10 minutes unused, so lodger holds no memory while you don't use it.
# Install: ln -s ~/Projects/sybil/lodger/systemd/lodger.service ~/.config/systemd/user/
#          systemctl --user daemon-reload && systemctl --user enable --now lodger
[Unit]
Description=lodger: local AI that steps aside for your apps
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/Projects/sybil/lodger/bin/lodger serve %h/models/qwen3.6-35b-a3b/Qwen3.6-35B-A3B-UD-IQ4_XS.gguf --allow-gpu --idle 10 --name qwen3.6-35b
Environment=PYTHONUNBUFFERED=1
# lodger stops its model itself on SIGTERM; give it time to
TimeoutStopSec=40
Restart=on-failure
RestartSec=30

[Install]
WantedBy=graphical-session.target
